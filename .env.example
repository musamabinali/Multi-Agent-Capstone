# MAKPA - Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# RUNTIME MODE AND THREAD NAMING
# =============================================================================
# Runtime mode: demo | free | live (default: demo)
# Required for: all modes
MAKPA_MODE=demo

# Thread identifier prefix for checkpointer (default: makpa)
# Required for: all modes
THREAD_ID_PREFIX=makpa

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# LLM provider preference: gemini | groq | mock (default: mock)
# Required for: free, live modes
LLM_PROVIDER=mock

# --- Gemini Configuration ---
# Google Gemini API key (required for free/live with gemini provider)
# Required for: free (if using gemini), live (if using gemini)
GEMINI_API_KEY=

# Gemini chat model name (default: gemini-1.5-flash)
# Required for: free (if using gemini), live (if using gemini)
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Gemini embedding model name (default: text-embedding-004)
# Required for: free (if using gemini embeddings), live (if using gemini embeddings)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Groq Configuration ---
# Groq API key (required for free/live with groq provider)
# Required for: free (if using groq), live (if using groq)
GROQ_API_KEY=

# Groq chat model name (default: llama-3.1-70b-versatile)
# Required for: free (if using groq), live (if using groq)
GROQ_CHAT_MODEL=llama-3.1-70b-versatile

# --- LLM Parameters ---
# Temperature for LLM generation (default: 0.1)
# Required for: all modes
LLM_TEMPERATURE=0.1

# Max tokens for LLM response (default: 4096)
# Required for: all modes
LLM_MAX_TOKENS=4096

# =============================================================================
# LANGSMITH TRACING
# =============================================================================
# LangSmith API key (enables tracing when set)
# Required for: free, live (optional but recommended)
LANGCHAIN_API_KEY=

# LangSmith project name (default: makpa)
# Required for: free, live (when tracing enabled)
LANGCHAIN_PROJECT=makpa

# Enable LangSmith tracing (default: true)
# Required for: free, live
LANGCHAIN_TRACING_V2=true

# =============================================================================
# GITHUB MCP
# =============================================================================
# GitHub fine-grained personal access token
# Required for: live mode
GITHUB_MCP_PAT=

# GitHub MCP server URL (default: https://api.githubcopilot.com/mcp/)
# Required for: live mode
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# GitHub MCP tool timeout in seconds (default: 30)
# Required for: live mode
MCP_TOOL_TIMEOUT_SECONDS=30

# GitHub MCP mode: auto | mock | real (default: auto)
# auto: real server when GITHUB_MCP_PAT is set, else mock STDIO server (demo)
# Required for: all modes
GITHUB_MCP_MODE=auto

# =============================================================================
# GOOGLE MCP
# =============================================================================
# Google OAuth client ID
# Required for: free (local), live modes
GOOGLE_CLIENT_ID=

# Google OAuth client secret (optional for PKCE, required for confidential clients)
# Required for: free (local, if not using PKCE), live modes
GOOGLE_CLIENT_SECRET=

# Google OAuth redirect URI (default: http://localhost:8080/callback)
# Required for: free (local), live modes
GOOGLE_REDIRECT_URI=http://localhost:8080/callback

# Google OAuth scopes (comma-separated)
# Required for: free (local), live modes
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.readonly

# Google token cache file path (default: ./data/google_token_cache.json)
# Required for: free (local), live modes
GOOGLE_TOKEN_CACHE_PATH=./data/google_token_cache.json

# Local OAuth callback server port (default: 8080)
# Required for: free (local), live modes
GOOGLE_OAUTH_REDIRECT_PORT=8080

# Attendee verification mode: own_only | all (default: own_only)
# own_only labels availability with attendees as partial and refuses auto-create;
# all verifies only the queried calendar, as before
GOOGLE_CALENDAR_ATTENDEE_MODE=own_only

# Google MCP mode: official | local | auto | mock (default: auto)
# auto: official URLs when configured, else local wrappers; mock forces zero-key fakes
# Required for: free, live modes
GOOGLE_MCP_MODE=auto

# Official Google Calendar MCP server URL
# Required for: live (when using official)
GOOGLE_CALENDAR_MCP_URL=https://calendar.mcp.google.com/mcp

# Official Gmail MCP server URL
# Required for: live (when using official)
GOOGLE_GMAIL_MCP_URL=https://gmail.mcp.google.com/mcp

# =============================================================================
# VECTOR STORE
# =============================================================================
# Vector store backend: pinecone | chroma_http | qdrant | chroma_local (default: chroma_local)
# Primary hosted store for free/live: chroma_http. Pinecone is a documented
# swap (serverless indexes only, SDK pinned <8 via langchain-pinecone).
# Required for: free, live modes
VECTOR_STORE=chroma_local

# --- Pinecone Configuration (documented swap, serverless-only) ---
# Pinecone API key
# Required for: free (if pinecone), live (if pinecone)
PINECONE_API_KEY=

# Pinecone index name (default: makpa-rag)
# Required for: free (if pinecone), live (if pinecone)
PINECONE_INDEX_NAME=makpa-rag

# Pinecone environment (default: us-east-1)
# Required for: free (if pinecone), live (if pinecone)
PINECONE_ENVIRONMENT=us-east-1

# Pinecone cloud provider (default: aws)
# Required for: free (if pinecone), live (if pinecone)
PINECONE_CLOUD=aws

# Pinecone region (default: us-east-1)
# Required for: free (if pinecone), live (if pinecone)
PINECONE_REGION=us-east-1

# --- Chroma HTTP Configuration ---
# Chroma HTTP host (default: localhost)
# Required for: free (if chroma_http), live (if chroma_http)
CHROMA_HOST=localhost

# Chroma HTTP port (default: 8000)
# Required for: free (if chroma_http), live (if chroma_http)
CHROMA_PORT=8000

# --- Qdrant Configuration ---
# Qdrant URL
# Required for: free (if qdrant), live (if qdrant)
QDRANT_URL=

# Qdrant API key
# Required for: free (if qdrant), live (if qdrant)
QDRANT_API_KEY=

# Qdrant collection name (default: makpa-rag)
# Required for: free (if qdrant), live (if qdrant)
QDRANT_COLLECTION_NAME=makpa-rag

# =============================================================================
# EMBEDDINGS
# =============================================================================
# Embedding provider: huggingface | gemini (default: huggingface)
# Required for: all modes
EMBEDDING_PROVIDER=huggingface

# HuggingFace embedding model name (default: sentence-transformers/all-MiniLM-L6-v2)
# Required for: all modes (when using huggingface)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding batch size (default: 32)
# Required for: all modes
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# RAG PARAMETERS
# =============================================================================
# Sample PDF path (default: ./data/sample.pdf)
# Required for: all modes
SAMPLE_PDF_PATH=./data/sample.pdf

# PDF loader: pypdf | pdfplumber | unstructured (default: pypdf)
# Required for: all modes
PDF_LOADER=pypdf

# Chunk size for recursive character splitter (default: 1000)
# Required for: all modes
RAG_CHUNK_SIZE=1000

# Chunk overlap for recursive character splitter (default: 200)
# Required for: all modes
RAG_CHUNK_OVERLAP=200

# Retriever k (number of final results) (default: 5)
# Required for: all modes
RAG_K=5

# Retriever fetch k (number of candidates for MMR) (default: 20)
# Required for: all modes
RAG_FETCH_K=20

# MMR lambda multiplier (default: 0.5)
# Required for: all modes
RAG_LAMBDA_MULT=0.5

# =============================================================================
# CHECKPOINTER
# =============================================================================
# Checkpointer backend: memory | sqlite (default: memory)
# Required for: all modes
CHECKPOINTER_BACKEND=memory

# SQLite checkpointer path (default: ./data/checkpoints.sqlite)
# Required for: all modes (when using sqlite)
CHECKPOINTER_SQLITE_PATH=./data/checkpoints.sqlite

# =============================================================================
# AUDIT LOG
# =============================================================================
# Audit log file path (default: ./data/audit.log)
# Required for: all modes
AUDIT_LOG_PATH=./data/audit.log

# =============================================================================
# LOGGING
# =============================================================================
# Logging level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# Required for: all modes
LOG_LEVEL=INFO

# Logging format: json | console (default: console)
# Required for: all modes
LOG_FORMAT=console